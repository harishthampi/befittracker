# Copy this file to .env.local and fill in the values.

# Supabase project (Project Settings -> API). The anon key is safe in the browser:
# Row-Level Security decides what each signed-in person can read or write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Lets the food-search route save database results into the shared
# food cache. Optional: without it, search still works, it just isn't cached.
# NEVER prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://fdc.nal.usda.gov/api-key-signup (about 1,000 requests/hour).
# Leave empty to use DEMO_KEY, which is heavily rate-limited (fine for a quick test).
USDA_API_KEY=

# Public URL of the app, used in email links (sign-up confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
